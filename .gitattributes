# Normalise line endings. Without this, committing from Windows stores CRLF
# and anyone on macOS or Linux sees whole files as changed.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
